.next/
out/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Lock files (regenerated on install)
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─────────────────────────────────────────────────────────────────────────────────

*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
*.egg
MANIFEST

# ─────────────────────────────────────────────────────────────────────────────────
# Environment Variables (CRITICAL - Never commit secrets!)
# ─────────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
agents/.env
frontend/.env.local
*.key
*.pem
secrets.json

